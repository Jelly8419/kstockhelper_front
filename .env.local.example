# Supabase — copy to .env.local and fill in your project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend endpoint that verifies a Bybit UID and upgrades the user to premium.
# Server-side only (used by app/api/bybit/verify). e.g. https://api.kstockhelper.com/api/bybit/verify
BYBIT_VERIFY_URL=

# Canonical site URL (optional; defaults to https://kstockhelper.com)
# NEXT_PUBLIC_SITE_URL=https://kstockhelper.com
