# Supabase — copy to .env.local and fill in your project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend host root (server-side only). Single source of truth for the backend
# host — all proxy routes derive their URLs from this (e.g. /api/bybit/verify,
# /api/subscription/*, /internal/admin, /api/price-gap, /api/feature-flags).
# e.g. http://localhost:8080  (local)  /  https://api.kstockhelper.com  (prod)
BACKEND_API_BASE=http://localhost:8080

# Shared secret sent to the backend on internal calls, if required.
INTERNAL_API_SECRET=

# Canonical site URL (optional; defaults to https://kstockhelper.com)
# NEXT_PUBLIC_SITE_URL=https://kstockhelper.com

# ---------------------------------------------------------------------------
# Legacy per-endpoint overrides (OPTIONAL).
# Leave these blank when BACKEND_API_BASE is set — they only exist for backward
# compatibility and, when present, take precedence over BACKEND_API_BASE for
# that one endpoint. Prefer BACKEND_API_BASE above.
# ---------------------------------------------------------------------------
# BYBIT_VERIFY_URL=          # full URL, e.g. https://api.kstockhelper.com/api/bybit/verify
# BINANCE_CONNECT_URL=       # full URL, e.g. https://api.kstockhelper.com/api/binance/connect
# SUBSCRIPTION_CREATE_URL=   # full URL, e.g. https://api.kstockhelper.com/api/subscription/create
# SUBSCRIPTION_CANCEL_URL=   # full URL, e.g. https://api.kstockhelper.com/api/subscription/cancel
# SUBSCRIPTION_STATUS_URL=   # full URL, e.g. https://api.kstockhelper.com/api/subscription/status
# ADMIN_API_BASE_URL=        # base + prefix, e.g. https://api.kstockhelper.com/internal/admin
# PRICE_GAP_API_BASE=        # base + prefix, e.g. https://api.kstockhelper.com/api/price-gap
# FEATURE_FLAGS_API_BASE=    # host root,     e.g. https://api.kstockhelper.com
